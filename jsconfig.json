{
   "compilerOptions": {
      "checkJs": true,
      "allowJs": true,
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "target": "ES2023",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "types": ["node"],
      "paths": {
         "@features/*": ["./features/*/index.js"],
         "@lib/*": ["./lib/*.js"]
      }
   },
   "include": ["**/*.js"],
   "exclude": ["node_modules", "coverage", "dist"]
}
