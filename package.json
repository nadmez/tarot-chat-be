{
   "name": "tarot_chat_be",
   "version": "0.0.0",
   "type": "module",
   "private": true,
   "engines": {
      "node": ">=20.11"
   },
   "scripts": {
      "dev": "node --import ./register-aliases.js --env-file=.env --watch index.js",
      "start": "node --import ./register-aliases.js index.js",
      "typecheck": "tsc --noEmit -p jsconfig.json",
      "test": "vitest run",
      "test:coverage": "vitest run --coverage",
      "test:watch": "vitest",
      "test:changed": "vitest run --changed --passWithNoTests",
      "test:related": "vitest related --run"
   },
   "dependencies": {
      "@supabase/supabase-js": "^2.97.0",
      "express": "^5.2.1",
      "i18next": "^23.7.6",
      "i18next-fs-backend": "^2.3.1",
      "openai": "^6.21.0",
      "zod": "^4.3.5"
   },
   "devDependencies": {
      "@types/express": "^5.0.6",
      "@types/node": "^22.13.0",
      "@types/supertest": "^7.2.1",
      "@vitest/coverage-v8": "^5.0.3",
      "supertest": "^7.3.1",
      "typescript": "~5.9.3",
      "vitest": "^5.0.3"
   }
}
